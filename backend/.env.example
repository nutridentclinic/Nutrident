PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DENTIST_PANEL_URL=
# Set TRUST_PROXY=1 when behind reverse proxy like Render
TRUST_PROXY=0
# Comma-separated list of allowed origins. In production on Render, set to your frontend domain only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MONGO_URI=replace-with-a-development-mongodb-uri

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters (64+ bytes recommended) and distinct from each other.
JWT_SECRET=replace-with-at-least-64-random-bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-random-bytes
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=replace-with-at-least-32-random-bytes-for-otp
BCRYPT_SALT_ROUNDS=10
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
BREVO_API_KEY=replace-me
EMAIL_FROM_ADDRESS=replace-with-verified-sender@example.com
EMAIL_FROM_NAME=DrNutrident
FIREBASE_SERVICE_ACCOUNT_BASE64=replace-with-base64-service-account
AGORA_APP_ID=replace-me
AGORA_APP_CERTIFICATE=replace-me
CLINIC_TIMEZONE=Asia/Kolkata
SINGLE_DENTIST_MODE=true
PENDING_APPOINTMENT_TTL_MINUTES=15
VIDEO_JOIN_EARLY_MINUTES=15
VIDEO_JOIN_LATE_MINUTES=30
ADMIN_EMAIL=replace-with-first-admin-email
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_PHONE=replace-with-first-admin-phone
ADMIN_NAME=Clinic Admin